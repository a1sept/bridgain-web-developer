{
  "name": "@bridgain/developer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "desktop": "npm --prefix desktop start",
    "desktop:check": "node desktop/check.mjs",
    "desktop:test": "node --test desktop/test/*.test.mjs",
    "desktop:install": "npm --prefix desktop ci"
  },
  "dependencies": {
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "mermaid": "^12.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
