{
  "name": "@bridgain/desktop",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "electron main.mjs",
    "start:remote": "electron remote.mjs",
    "check": "node check.mjs",
    "test": "node --test test/*.test.mjs",
    "postinstall": "node prepare-pty.mjs",
    "prestart": "node prepare-pty.mjs",
    "pack": "electron-builder --config electron-builder.cjs --dir --publish never",
    "dist": "electron-builder --config electron-builder.cjs --publish never"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "26.18.1",
    "playwright": "1.65.0"
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "node-pty": "^1.1.0"
  },
  "description": "Bridgain desktop workspace",
  "author": "Bridgain"
}
